      "id": "lesson-20261015-nejimaki",
      "date": "10/15",
      "teacher": "ねじまき鳥",
      "title": "牌譜検討③｜一向聴の質・基本序列・七対子",
      "videoUrl": "https://www.youtube.com/watch?v=guKgCOJ_Kng"
    }
